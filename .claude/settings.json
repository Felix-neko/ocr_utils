{
  "permissions": {
    "allow": [
      "Bash(uv run pytest*)",
      "Bash(uv run black*)",
      "Bash(uv run python scripts/gen_module_map.py*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git ls-files*)",
      "Bash(ps *)",
      "Bash(kill -0 *)",
      "Bash(iostat*)",
      "Bash(nvidia-smi*)",
      "Bash(df *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(docker image prune -a*)",
      "Bash(docker volume prune*)",
      "Bash(docker system prune*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_bash.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format_py.sh"
          }
        ]
      }
    ]
  }
}

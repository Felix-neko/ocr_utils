# Конфигурация локального CVAT.
# ВНИМАНИЕ: значения БЕЗ кавычек (docker compose и docker run --env-file
# берут всё после первого '=' как есть, включая пробелы и кириллицу).

# Версия CVAT (образы cvat/server, cvat/ui и тег git-репозитория).
CVAT_VERSION=v2.70.0

# Хост и порт, на которых открывается веб-интерфейс (http://CVAT_HOST:CVAT_PORT).
CVAT_HOST=localhost
CVAT_PORT=8080

# Папка с картинками для разметки (монтируется в /home/django/share, read-only).
# Это НЕ оригиналы, а их копии, уменьшённые в 4 раза по каждой стороне
# (downscale_for_cvat.py): CVAT не масштабирует кадры сам, а полноразмерные
# сканы ~4600x3600 он режет на чанки по 5 кадров и делает это медленно.
# ВАЖНО: разметка будет в координатах уменьшенных кадров — для применения
# к оригиналам умножать на 4.
IMAGES_DIR=/mnt/dump3/mts_downscaled_x4

# Оригиналы (в разметке не участвуют, оставлено для справки):
# /mnt/dump3/yandex_disk_linux_baby_zergling/Общее/Фотки/МТС/в работе

# Учётные записи (создаются автоматически при первом запуске up.sh).
# admin  — суперпользователь, может создавать проекты/задачи.
# user   — обычный аннотатор (роль worker в организации), только разметка.
ADMIN_USER=admin
ADMIN_PASS=admin
ANN_USER=user
ANN_PASS=user

# Организация и проект.
ORG_SLUG=masochists
ORG_NAME=Клуб мазохистов
PROJECT_NAME=Материально-техническое снабжение

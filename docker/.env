# Конфигурация локального CVAT.
# ВНИМАНИЕ: значения БЕЗ кавычек (docker compose и docker run --env-file
# берут всё после первого '=' как есть, включая пробелы и кириллицу).

# Версия CVAT (образы cvat/server, cvat/ui и тег git-репозитория).
CVAT_VERSION=v2.70.0

# Хост и порт, на которых открывается веб-интерфейс (http://CVAT_HOST:CVAT_PORT).
#
# 8080 НЕ занимать: он оставлен под airflow. Порт публикуется только наружу — внутри
# контейнера сервер как слушал 8080, так и слушает, а traefik маршрутизирует по имени
# хоста, а не по порту, поэтому смена значения здесь достаточна.
CVAT_HOST=localhost
CVAT_PORT=8081

# Папка с картинками для разметки (монтируется в /home/django/share, read-only).
# Это НЕ оригиналы, а их уменьшённые копии: CVAT не масштабирует кадры сам, а
# полноразмерные сканы ~4600x3600 он режет на чанки по 5 кадров и делает это медленно.
# ВАЖНО: разметка будет в координатах уменьшенных кадров — для применения к оригиналам
# умножать на делитель (у scan_markup он свой у каждой полосы и лежит в базе).
#
# Лежит на SSD, а не на /mnt/dump3: оригиналы читаются по разу, а превью CVAT листает
# постранично, и на шпиндельном NTFS-3G это ощутимо медленнее.
#
# Подсистема ocr_utils.scan_markup держит СВОИ уменьшенные копии (75 dpi, делитель
# считается из DPI каждого файла) в дереве <пак>/<год>/<выпуск>/<полоса>.jpg и заводит
# задачи сама; сюда указывает её --share-root, который обязан лежать ВНУТРИ этого каталога
# (CVAT берёт картинки из смонтированного share и по сети их не получает).
IMAGES_DIR=/home/felix/Projects/mts_markup/cvat_share

# Оригиналы (в разметке не участвуют, оставлено для справки):
# /mnt/dump3/yandex_disk_linux_baby_zergling/Общее/Фотки/МТС/в работе

# Учётные записи (создаются автоматически при первом запуске up.sh).
# admin  — суперпользователь, может создавать проекты/задачи.
# user   — обычный аннотатор (роль worker в организации), только разметка.
ADMIN_USER=admin
ADMIN_PASS=admin
ANN_USER=user
ANN_PASS=user
# Роль разметчика в организации: worker | supervisor | maintainer.
#
# worker и supervisor видят ТОЛЬКО назначенные им джобы: вкладки Projects и Tasks у них
# пусты всегда (проверено на 2.70.0 — разница между этими двумя не в видимости, а в праве
# заводить задачи). Обзор по годам и выпускам открывает только maintainer.
ANN_ROLE=maintainer

# Организация. Проект в CVAT заводит `scan_markup to-cvat` — по имени пака.
ORG_SLUG=masochists
ORG_NAME=Клуб мазохистов

/.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
dist/
build/
.idea/
/uv.lock
/finger_models/
/third_party/
/dewarp_models/
/ai_slop/
!/ai_slop/.gitkeep

# Выхлоп прогонов, а не исходники. Отчёты-РАЗБОРЫ (*_report.md и подобные) в репозитории
# как раз лежат — они написаны руками и объясняют, почему всё устроено так. А вот то, что
# печатает сам инструмент по конкретной партии, привязано к чужой файловой системе и
# устаревает с первым же перезапуском.
/defocus_si_*.csv
/defocus_si_*.md
/defocus_si_*.txt
/defocus_si_*_worst/
/defocus_lines_si_*.csv
/defocus_lines_si_*.md
/defocus_lines_si_*.txt
/defocus_lines_si_*_worst/
/defocus_lines_si_*_debug/
/defocus_dom_*.csv
/defocus_dom_*.md
/defocus_dom_*.txt
# Таблицы признаков свипа по 4009 кадрам: 7 МБ промежуточных чисел, пересчитываются
# из тех же снимков за несколько минут. Разбор по ним (si_metrics_tables.md) лежит рядом
# и в репозитории остаётся.
/defocus_calibration/*.csv
/defocus_compare_*/
/surya_lines_check/
/.cache/
# Папки симлинков от --link-dir: ссылки указывают на /mnt/dump3 и на другой машине битые.
*_worst/
# Списки страниц и прочие рабочие выписки по партиям.
/si_*.txt
/select_best_raws_*_report.txt
/focus_series_250/
# Пробные кадры и логи прогонов.
/IMG_*.tiff
/ocr_utils/background_smoothing/run_log.txt
/ocr_utils/legacy/stamp_and_writing_detection/test_pics/

# Отдельное окружение под PaddleOCR (research/legacy/table_processing): ставится через
# `uv sync --project research/legacy/table_processing/paddle_env`, в репозитории ему не место.
research/legacy/table_processing/paddle_env/.venv/
research/legacy/table_processing/paddle_env/uv.lock

# Debug-наборы сверки детектора таблиц: около 190 МБ картинок, которые смотрят глазами.
# Сами отчёты и CSV из этой папки при желании коммитятся руками.
reports/проверка детектора таблиц/оверлеи_старый/
reports/проверка детектора таблиц/оверлеи_новый/
reports/проверка детектора таблиц/страницы_finereader/
reports/проверка детектора таблиц/листы/
reports/проверка детектора таблиц/нашёл finereader, новый детектор не нашёл/

# Приёмка третьей версии детектора: те же debug-наборы, тот же объём.
reports/сверка детектора v3/оверлеи_старый/
reports/сверка детектора v3/оверлеи_новый/
reports/сверка детектора v3/оверлеи_v3/
reports/сверка детектора v3/страницы_finereader/
reports/сверка детектора v3/листы/
reports/детектор v3/оверлеи_v2/
reports/детектор v3/оверлеи_v3/

# Четвёртая версия: сравнение на размеченных полосах и приёмка по паку.
reports/детектор v4/оверлеи_v2/
reports/детектор v4/оверлеи_v3/
reports/детектор v4/оверлеи_v4/
reports/сверка детектора v4/оверлеи_старый/
reports/сверка детектора v4/оверлеи_новый/
reports/сверка детектора v4/оверлеи_v3/
reports/сверка детектора v4/оверлеи_v4/
reports/сверка детектора v4/страницы_finereader/
reports/сверка детектора v4/листы/

# Прогон детектора v.4.2 по исходным сканам «Готовое» (те же debug-наборы).
reports/прогон детектора таблиц v.4.2/оверлеи_старый/
reports/прогон детектора таблиц v.4.2/оверлеи_новый/
reports/прогон детектора таблиц v.4.2/оверлеи_v3/
reports/прогон детектора таблиц v.4.2/оверлеи_v4/
reports/прогон детектора таблиц v.4.2/страницы_finereader/
reports/прогон детектора таблиц v.4.2/листы/

# Колёса, скачанные руками для локальных окружений (research/external_ocr_models/local/*/wheels)
wheels/
research/external_ocr_models/local/*/weights/
research/external_ocr_models/local/*/sync.log
research/external_ocr_models/damaged/

# Выходы прогонов, которые run-скрипты кладут в корень репо (BASE_NAME в шапке скрипта):
# csv с метриками всех полос, машинные md-сводки, контактные листы, симлинки и оверлеи.
# Рукописные отчёты живут в reports/, эти файлы — расходный материал прогона.
/curved_lines_pack1*
/orientation_pack1*
/faint_ink_pack1*
/line_art_pack1*
/show_through_ph_*
/defocus_lap_si_*
/mts_risky_names.*
/finereader_compare_pack1.md
/eg_82_1_3.txt
/*_sheet_*.png
/*_sheet.png

# Базы разметки (ручная разметка из CVAT, невоспроизводимы): живут в ~/Projects/mts_markup,
# в репозитории им не место ни как копии, ни как бэкапу.
*.sqlite
*.sqlite.bak
